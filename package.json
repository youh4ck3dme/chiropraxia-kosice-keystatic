{
  "name": "chiropraxia-kosice",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "20.x"
  },
  "description": "Chiropraxia Košice - Premium PWA with Headless Booking System",
  "scripts": {
    "setup": "node scripts/setup-dev.js",
    "diagnose": "node scripts/diagnose.js",
    "verify:keystatic": "node scripts/verify-keystatic-github.js",
    "dev": "astro dev",
    "dev:safe": "node scripts/setup-dev.js && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:safe": "node scripts/setup-dev.js && astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "vercel:link": "vercel link --yes",
    "vercel:env-push": "node scripts/vercel-env-push.js",
    "vercel:env-production-public": "node scripts/vercel-env-production-public.js",
    "deploy": "vercel deploy --prod --yes"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/react": "^3.0.5",
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@formkit/auto-animate": "^0.9.0",
    "@google/generative-ai": "^0.24.1",
    "@keystatic/astro": "^5.0.6",
    "@keystatic/core": "^0.5.48",
    "@nanostores/react": "^1.0.0",
    "@sentry/astro": "^10.32.1",
    "@spotlightjs/astro": "^3.2.6",
    "@tailwindcss/vite": "^4.1.18",
    "@types/lodash": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/react-big-calendar": "^1.16.3",
    "@vercel/og": "^0.8.6",
    "ai": "^6.0.5",
    "astro": "^5.16.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.22",
    "nanostores": "^1.1.0",
    "react": "^19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.3",
    "resend": "^6.6.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.11.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/astro": "^1.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.16"
  }
}
