# Optional – Supabase is currently suspended. Uncomment and set when re-enabling DB (see docs/SUPABASE_SETUP.md).
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev
BOOKING_EMAIL=booking@chiropraxiakosice.eu
# Local dev uses port 4322 (match astro.config.mjs). In production set to your real site URL.
SITE_URL=http://localhost:4322
# JWT pre tokeny (min. 16 znakov); v produkcii použiť silný náhodný reťazec
JWT_SECRET=

# Admin scripts (scripts/create-admin.cjs, scripts/verify-auth.cjs)
# Set these before running the admin setup scripts — never commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# SMS Configuration (Twilio). When Supabase is suspended, SMS is controlled by SMS_ENABLED (default: off).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# SMS_ENABLED=true
# SMS_TEMPLATE=Dobrý deň {name}, vaša rezervácia na {date} o {time}...

# Keystatic (GitHub mode). Production: chiropraxiakosice.eu, GitHub account: youh4ck3dme.
# Callback URL in GitHub OAuth App (Settings → Developer settings → OAuth Apps):
#   Production: https://chiropraxiakosice.eu/api/keystatic/github/oauth/callback
#   Local:      http://localhost:4322/api/keystatic/github/oauth/callback
KEYSTATIC_STORAGE=github
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Slug GitHub App (fallback v kóde: keystatic-chiropraxia-kosice)
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=keystatic-chiropraxia-kosice
# Optional: set SKIP_KEYSTATIC=true in production to disable /keystatic UI (see docs/KEYSTATIC.md)
# SKIP_KEYSTATIC=
