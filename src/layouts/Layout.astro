---
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PWAInstallPrompt from '../components/PWAInstallPrompt.astro';
import Logo from '../components/Logo.astro';
import { AuroraBackground } from '../components/react/AuroraBackground';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  faqs?: { question: string; answer: string }[];
  rating?: { value: number; count: number };
}

const { 
  title = 'Chiropraxia Košice | Profesionálna chiropraktická starostlivosť',
  description = 'Riešime bolesti chrbta, krčnej chrbtice, migrény a pohybové problémy. Objednajte sa online na vyšetrenie u skúseného chiropraktika v Košiciach.',
  keywords,
  faqs,
  rating
} = Astro.props;
---

<!DOCTYPE html>
<html lang="sk" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b1e" />
    <meta name="author" content="Chiropraxia Košice" />
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- PWA -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chiropraxia" />
    
    <!-- Fonts are now self-hosted via @fontsource (see global.css) -->
    
    <meta name="google-site-verification" content="nBWrTuI-LpuQxt8PL73Gj7fflQdKgInjZiWcGnltH-4" />
    <title>{title}</title>
    
    <!-- Google Analytics (GA4) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXRKJKX56Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Default to denied for GDPR compliance
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied'
      });

      gtag('config', 'G-HXRKJKX56Y');
    </script>
    
    <!-- SEO & Schema.org -->
    <SEO title={title} description={description} keywords={keywords} faqs={faqs} rating={rating} />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />
    
    <slot name="head" />
  </head>
  
  <body class="min-h-screen">
    <AuroraBackground client:load data-astro-transition-persist="aurora-bg" />

    
    <!-- Main Content -->
    <div class="relative z-10">
      <!-- Header -->
      <header class="fixed top-0 left-0 right-0 z-50">
        <nav class="glass-card mx-4 mt-4 px-6 py-4.5 flex items-center justify-between">
          <a href="/" class="flex items-center" aria-label="Chiropraxia Košice">
            <Logo className="h-8.5 md:h-10.5 w-auto" />
          </a>
          
          <div class="hidden md:flex items-center gap-8">
            <a href="/" class="text-lg font-bold text-[#1e293b] hover:text-[#006fb8] transition-colors">Domov</a>
            <a href="/sluzby" class="text-lg font-bold text-[#1e293b] hover:text-[#006fb8] transition-colors">Služby</a>
            <a href="/blog" class="text-lg font-bold text-[#1e293b] hover:text-[#006fb8] transition-colors">Blog</a>
            <a href="https://booking.fyzioafit.sk" class="btn-aurora text-sm">
              <span>Rezervovať</span>
            </a>
          </div>
          
          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="md:hidden p-2 text-chrome-gray hover:text-chrome-white transition-colors" aria-label="Menu">
            <div class="w-6 h-5 relative flex flex-col justify-between">
              <span class="w-full h-0.5 bg-current rounded-full transition-all duration-300 origin-left"></span>
              <span class="w-full h-0.5 bg-current rounded-full transition-all duration-300"></span>
              <span class="w-full h-0.5 bg-current rounded-full transition-all duration-300 origin-left"></span>
            </div>
          </button>
        </nav>

        <!-- Mobile Menu Overlay -->
        <div id="mobile-menu" class="fixed inset-0 z-40 bg-void/95 backdrop-blur-xl transition-all duration-300 opacity-0 pointer-events-none" style="top: 80px;">
          <div class="flex flex-col items-center justify-center p-8 space-y-8">
            <a href="/" class="text-2xl font-medium text-chrome-gray hover:text-white transition-colors">Domov</a>
            <a href="/sluzby" class="text-2xl font-medium text-chrome-gray hover:text-white transition-colors">Služby</a>
            <a href="/blog" class="text-2xl font-medium text-chrome-gray hover:text-white transition-colors">Blog</a>
            <a href="https://booking.fyzioafit.sk" class="btn-aurora text-lg px-8 py-3 w-full max-w-xs text-center">
              <span>Rezervovať</span>
            </a>
          </div>
        </div>
      </header>
      
      <script>
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const spans = btn?.querySelectorAll('span');
        let isOpen = false;

        btn?.addEventListener('click', () => {
          isOpen = !isOpen;
          
          // Toggle menu visibility
          if (isOpen) {
            menu?.classList.remove('opacity-0', 'pointer-events-none');
            // Animate hamburger to X
            spans?.[0].classList.add('rotate-45');
            spans?.[1].classList.add('opacity-0');
            spans?.[2].classList.add('-rotate-45');
          } else {
            menu?.classList.add('opacity-0', 'pointer-events-none');
            // Reset hamburger
            spans?.[0].classList.remove('rotate-45');
            spans?.[1].classList.remove('opacity-0');
            spans?.[2].classList.remove('-rotate-45');
          }
        });

        // Close menu on link click
        menu?.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
             isOpen = false;
             menu?.classList.add('opacity-0', 'pointer-events-none');
             spans?.[0].classList.remove('rotate-45');
             spans?.[1].classList.remove('opacity-0');
             spans?.[2].classList.remove('-rotate-45');
          });
        });
      </script>

      <!-- Page Content -->
      <main class="pt-24">
        <slot />
      </main>

      <!-- Footer -->
      <Footer />
    </div>

    <aside aria-label="Notifikácie a súhlasy">
      <PWAInstallPrompt />
      <CookieConsent />
    </aside>

  </body>
</html>

<script>
  // 3D Parallax Effect for Headers
  // Static 3D Effect for Headers (No Mouse Movement)
  const initParallax = () => {
    const containers = document.querySelectorAll('.parallax-3d');
    
    // Set fixed 3D transform
    containers.forEach(container => {
      const header = container.querySelector('h1, h2, h3') as HTMLElement;
      if (header) {
        // Fixed perspective tilt
        header.style.transform = `rotateY(5deg) rotateX(5deg) translateZ(40px)`;
        // Fixed shadow
        header.style.filter = `drop-shadow(-10px 10px 20px rgba(137, 207, 240, 0.3))`;
      }
    });
  };

  // Initialize on page load and after transitions
  initParallax();
  document.addEventListener('astro:after-swap', initParallax);
</script>
