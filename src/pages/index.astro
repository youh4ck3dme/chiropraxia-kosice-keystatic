<script>
    interface BlockerRect {
        left: number;
        top: number;
        width: number;
        height: number;
    }

    class Bubble {
        canvas: HTMLCanvasElement;
        blockers: BlockerRect[];
        radius: number = 0;
        x: number = 0;
        y: number = 0;
        vx: number = 0;
        vy: number = 0;
        opacity: number = 0;

        constructor(canvas: HTMLCanvasElement, blockers: BlockerRect[]) {
            this.canvas = canvas;
            this.blockers = blockers;
            this.init();
        }

        init() {
            this.radius = Math.random() * 80 + 35;
            this.x = Math.random() * this.canvas.width;
            this.y = Math.random() * this.canvas.height;
            this.vx = (Math.random() - 0.5) * 0.4;
            this.vy = (Math.random() - 0.5) * 0.4;
            this.opacity = Math.random() * 0.3 + 0.5;
        }

        update(mouse: { x: number | null, y: number | null }) {
            this.x += this.vx;
            this.y += this.vy;

            if (this.x < -this.radius) this.x = this.canvas.width + this.radius;
            if (this.x > this.canvas.width + this.radius) this.x = -this.radius;
            if (this.y < -this.radius) this.y = this.canvas.height + this.radius;
            if (this.y > this.canvas.height + this.radius) this.y = -this.radius;

            this.blockers.forEach(rect => {
                const dx = this.x - (rect.left + rect.width / 2);
                const dy = this.y - (rect.top + rect.height / 2);
                const distance = Math.sqrt(dx * dx + dy * dy);
                const minDistance = this.radius + Math.max(rect.width, rect.height) / 1.5;

                if (distance < minDistance) {
                    const angle = Math.atan2(dy, dx);
                    const force = (minDistance - distance) / minDistance;
                    this.vx += Math.cos(angle) * force * 0.15;
                    this.vy += Math.sin(angle) * force * 0.15;
                }
            });

            if (mouse.x !== null && mouse.y !== null) {
                const dx = this.x - mouse.x;
                const dy = this.y - mouse.y;
                const distance = Math.sqrt(dx * dx + dy * dy);
                if (distance < 200) {
                    const angle = Math.atan2(dy, dx);
                    const force = (200 - distance) / 200;
                    this.vx += Math.cos(angle) * force * 0.08;
                    this.vy += Math.sin(angle) * force * 0.08;
                }
            }
        }

        draw(ctx: CanvasRenderingContext2D) {
            const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
            gradient.addColorStop(0, `rgba(200, 235, 255, 0)`);
            gradient.addColorStop(0.5, `rgba(224, 245, 255, ${this.opacity * 0.5})`);
            gradient.addColorStop(0.9, `rgba(255, 255, 255, ${this.opacity * 0.9})`);
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.beginPath();
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();
        }
    }

    let animationFrameId: number | null = null;
    const mousePos: { x: number | null, y: number | null } = { x: null, y: null };

    function initHeroAnimation() {
        const canvas = document.getElementById('hero-bubbles-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        if (animationFrameId) cancelAnimationFrame(animationFrameId);

        const parent = canvas.parentElement;
        if (!parent) return;

        canvas.width = parent.offsetWidth;
        canvas.height = parent.offsetHeight;

        const blockerElements = parent.querySelectorAll('[data-bubble-blocker]');
        const blockers: BlockerRect[] = Array.from(blockerElements).map(el => {
            const rect = el.getBoundingClientRect();
            const parentRect = parent.getBoundingClientRect();
            return {
                left: rect.left - parentRect.left,
                top: rect.top - parentRect.top,
                width: rect.width,
                height: rect.height
            };
        });

        const bubbles = Array.from({ length: 15 }, () => new Bubble(canvas, blockers));

        function animate() {
            if (!ctx) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            bubbles.forEach(b => { b.update(mousePos); b.draw(ctx); });
            animationFrameId = requestAnimationFrame(animate);
        }
        animate();
    }

    const handleMouseMove = (e: MouseEvent) => {
        const canvas = document.getElementById('hero-bubbles-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        mousePos.x = e.clientX - rect.left;
        mousePos.y = e.clientY - rect.top;
    };

    function setup() {
        if (!document.getElementById('hero-bubbles-canvas')) return;
        initHeroAnimation();
        setTimeout(initHeroAnimation, 300);
        window.addEventListener('resize', initHeroAnimation);
        window.addEventListener('mousemove', handleMouseMove);
    }

    function cleanup() {
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
        window.removeEventListener('resize', initHeroAnimation);
        window.removeEventListener('mousemove', handleMouseMove);
    }

    document.addEventListener('astro:page-load', setup);
    document.addEventListener('astro:before-swap', cleanup);
    if (document.readyState === 'complete') setup();
</script>
