---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Stránka nenájdená | Chiropraxia Košice">
  <main class="relative flex min-h-[80vh] items-center justify-center overflow-hidden px-6">
    <div class="relative z-10 mx-auto max-w-2xl text-center">
      <div class="relative mb-8 inline-block">
        <h1 class="text-[120px] leading-none font-black text-white/5 select-none md:text-[180px]">
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="bg-aurora/20 h-32 w-32 animate-pulse rounded-full blur-3xl md:h-48 md:w-48">
          </div>
        </div>
      </div>

      <div class="-mt-12 space-y-6 md:-mt-20">
        <h2 class="text-chrome text-3xl font-bold tracking-tight md:text-5xl">
          Ups! Táto stránka bola <span class="text-aurora-glow">napravená</span> až príliš.
        </h2>

        <p class="text-chrome-gray mx-auto max-w-xl text-lg leading-relaxed md:text-xl">
          Zrejme sme ju "pukli" tak silno, že zmizla z existencie. <br class="hidden md:block" />
          Vráťme vašu chrbticu (a vás) späť do rovnováhy.
        </p>

        <div
          class="animate-slide-up mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row"
        >
          <a href="/" class="btn-glass px-10"> Späť na domov </a>
          <a href="/rezervacia" class="btn-aurora px-10">
            <span>Objednať sa online</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
