---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/blog/Breadcrumbs.astro';
import ShareButtons from '../../components/blog/ShareButtons.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import Newsletter from '../../components/Newsletter.astro';
import SeoPanelTrigger from '../../components/admin/SeoPanelTrigger';

// MDX Components
import Callout from '../../components/mdx/Callout.astro';
import FAQ from '../../components/mdx/FAQ.astro';
import VideoEmbed from '../../components/mdx/VideoEmbed.astro';
import BeforeAfter from '../../components/mdx/BeforeAfter.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const publishedPosts = posts.filter((post) => post.data.status !== 'draft');
  return publishedPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Calculate approximate reading time (200 words per minute)
const wordCount = post.body.split(/\s+/g).length;
const readTime = Math.ceil(wordCount / 200);

const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('sk-SK', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const fullUrl = `https://chiropraxiakosice.eu/blog/${post.slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.seoDescription,
  image: post.data.coverImage ? [`https://chiropraxiakosice.eu${post.data.coverImage}`] : [],
  datePublished: post.data.publishDate.toISOString(),
  dateModified: post.data.publishDate.toISOString(), // In real app, this should be updated date
  author: {
    '@type': 'Person',
    name: post.data.author,
    jobTitle: 'Certifikovaný Chiropraktik & Fyzioterapeut',
    url: 'https://chiropraxiakosice.eu/o-nas',
    knowsAbout: ['Chiropraxia', 'Fyzioterapia', 'Muskuloskeletálna medicína'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'Chiropraxia Košice',
    logo: {
      '@type': 'ImageObject',
      url: 'https://chiropraxiakosice.eu/logo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': fullUrl,
  },
  wordCount: wordCount,
  articleBody: post.body.substring(0, 150) + '...', // Truncated body for schema validity without bloat
};
---

<Layout
  title={(post.data.metaTitle || post.data.title) + ' | Chiropraxia Košice'}
  description={post.data.seoDescription}
  keywords={post.data.keywords || 'blog chiropraxia kosice, zdravotne clanky, bolest chrbta rady'}
>
  <!-- Advanced Schema -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Reading Progress Bar Script -->
  <script>
    const progressBar = document.getElementById('reading-progress');
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (progressBar) {
        progressBar.style.width = (scrolled || 0) + '%';
      }
    });
  </script>

  <!-- Sticky Progress Bar -->
  <div class="bg-chrome-dark/50 fixed top-0 left-0 z-50 h-1 w-full backdrop-blur-sm">
    <div
      id="reading-progress"
      class="bg-aurora-grad h-full w-0 transition-all duration-100 ease-out"
    >
    </div>
  </div>

  <article class="relative min-h-screen pb-24">
    <!-- Hero Background Blur -->
    <div
      class="from-aurora-purple/20 pointer-events-none absolute inset-x-0 top-0 -z-10 h-[500px] bg-gradient-to-b to-transparent"
    >
    </div>

    <div class="mx-auto max-w-4xl px-6 py-12">
      <!-- Breadcrumbs -->
      <Breadcrumbs title={post.data.title} />

      <!-- Header -->
      <header class="mb-10 text-center md:text-left">
        <div
          class="text-chrome-gray mb-6 flex flex-wrap items-center justify-center gap-4 text-sm md:justify-start"
        >
          <span
            class="bg-chrome-surface text-aurora-teal rounded-full border border-white/5 px-3 py-1 text-xs font-medium tracking-wider uppercase"
          >
            {post.data.category || 'Zdravie'}
          </span>
          <span
            class="text-aurora-teal/80 bg-aurora-teal/10 border-aurora-teal/20 flex items-center gap-1 rounded-md border px-2 py-1"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
            >
            Medically Reviewed
          </span>
          <span class="flex items-center gap-1">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line
                x1="16"
                y1="2"
                x2="16"
                y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
                x1="3"
                y1="10"
                x2="21"
                y2="10"></line></svg
            >
            {formatDate(post.data.publishDate)}
          </span>
          <span class="flex items-center gap-1">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
              ></polyline></svg
            >
            {readTime} min čítania
          </span>
        </div>

        <h1
          class="text-chrome mb-6 text-3xl leading-tight font-black text-balance md:text-5xl lg:text-6xl"
        >
          {post.data.title}
        </h1>

        <p class="text-chrome-gray/90 max-w-2xl text-xl leading-relaxed text-balance md:text-2xl">
          {post.data.seoDescription}
        </p>
      </header>

      <!-- Cover Image with "Cinematic" Glare -->
      {
        post.data.coverImage && (
          <div class="group shadow-aurora-purple/10 relative mb-16 overflow-hidden rounded-2xl border border-white/5 shadow-2xl">
            <div class="from-chrome-dark/80 absolute inset-0 z-10 bg-gradient-to-t to-transparent" />
            <img
              src={post.data.coverImage}
              alt={post.data.coverImageAlt || post.data.title}
              class="aspect-[21/9] w-full transform object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }

      <div class="grid gap-12 lg:grid-cols-[1fr_300px]">
        <!-- Main Content -->
        <main>
          <div
            class="prose prose-invert prose-lg prose-headings:text-chrome prose-headings:font-bold prose-headings:tracking-tight prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h2:bg-gradient-to-r prose-h2:from-white prose-h2:to-gray-400 prose-h2:bg-clip-text prose-h2:text-transparent prose-h3:text-2xl prose-h3:mt-12 prose-h3:mb-4 prose-p:text-gray-300 prose-p:leading-8 prose-p:mb-8 prose-p:font-light prose-a:text-aurora-teal prose-a:font-medium prose-a:no-underline hover:prose-a:text-aurora-purple hover:prose-a:underline prose-strong:text-white prose-strong:font-semibold prose-ul:text-gray-300 prose-ul:my-6 prose-li:my-2 prose-li:pl-2 prose-blockquote:border-l-4 prose-blockquote:border-aurora-teal prose-blockquote:bg-white/5 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:rounded-r-xl prose-blockquote:italic prose-blockquote:text-gray-200 prose-img:rounded-xl prose-img:shadow-lg max-w-none transition-colors"
          >
            <Content components={{ Callout, FAQ, VideoEmbed, BeforeAfter }} />
          </div>

          <!-- Share Section (Bottom) -->
          <div class="mt-16 border-t border-white/10 pt-8">
            <ShareButtons url={fullUrl} title={post.data.title} />
          </div>

          <!-- Related Articles -->
          <RelatedArticles
            currentSlug={post.slug}
            currentCategory={post.data.category || 'general'}
          />

          <!-- Newsletter Signup -->
          <div class="mt-16 border-t border-white/10 pt-16">
            <Newsletter />
          </div>
        </main>

        <!-- Sidebar (Desktop Sticky) -->
        <aside class="hidden h-full space-y-8 lg:block">
          <div class="sticky top-32 space-y-8">
            <!-- Table of Contents (New) -->
            <TableOfContents headings={headings} />

            <!-- Author Box -->
            <div class="glass-card border border-white/5 p-6 backdrop-blur-xl">
              <div class="mb-4 flex items-center gap-4">
                <div
                  class="border-aurora-teal relative h-12 w-12 overflow-hidden rounded-full border-2 bg-gray-800"
                >
                  <!-- Placeholder for author image -->
                  <img
                    src="/images/team/martin-kovac.jpg"
                    alt={post.data.author}
                    class="h-full w-full object-cover"
                  />
                </div>
                <div>
                  <p
                    class="text-aurora-teal mb-0.5 text-[10px] font-bold tracking-widest uppercase"
                  >
                    Odborný Garant
                  </p>
                  <p class="text-chrome flex items-center gap-1 font-bold">
                    {post.data.author}
                    <span title="Overený lekár" class="cursor-help">
                      <svg class="h-4 w-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20"
                        ><path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"></path></svg
                      >
                    </span>
                  </p>
                  <p class="text-[11px] leading-tight text-gray-400">
                    Certifikovaný Chiropraktik & Fyzioterapeut
                  </p>
                </div>
              </div>
              <p class="mb-4 border-t border-white/5 pt-3 text-sm text-gray-400">
                Špecialista na diagnostiku a liečbu funkčných porúch pohybového ústrojenstva s
                dlhoročnou praxou.
              </p>
            </div>

            <!-- CTA Box -->
            <div
              class="glass-card from-aurora-purple/10 border-aurora-purple/20 border bg-gradient-to-br to-transparent p-6"
            >
              <h3 class="mb-2 font-bold text-white">Trápi vás podobný problém?</h3>
              <p class="mb-6 text-sm text-gray-400">
                Neodkladajte liečbu. Rezervujte si termín u odborníka ešte dnes.
              </p>
              <a href="/rezervacia" class="btn-aurora flex w-full justify-center py-3 text-sm">
                Rezervovať termín
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <!-- Mobile Sticky CTA (Bottom) -->
  <div class="fixed bottom-6 left-1/2 z-40 w-[90%] max-w-sm -translate-x-1/2 lg:hidden">
    <a
      href="/rezervacia"
      class="glass-card border-aurora-teal/30 animate-fade-in-up flex items-center justify-between bg-black/80 p-4 shadow-2xl backdrop-blur-xl"
    >
      <div class="flex flex-col">
        <span class="text-xs text-gray-400 uppercase">Bolí to?</span>
        <span class="font-bold text-white">Objednať vyšetrenie</span>
      </div>
      <div
        class="bg-aurora-teal flex h-10 w-10 items-center justify-center rounded-full text-black"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
        >
      </div>
    </a>
  </div>

  <!-- SEO panel (visible when ?seo=1; for editors) -->
  <SeoPanelTrigger
    client:load
    title={post.data.title}
    metaTitle={post.data.metaTitle ?? null}
    seoDescription={post.data.seoDescription}
    slug={post.slug}
    focusKeyword={post.data.focusKeyword ?? null}
    coverImageAlt={post.data.coverImageAlt ?? null}
    body={post.body}
  />
</Layout>
