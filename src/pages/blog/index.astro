---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FyzioFitBanner from '../../components/FyzioFitBanner.astro';

// Get all blog posts
const posts = await getCollection('blog');
const publishedPosts = posts.filter((post) => post.data.status !== 'draft');
const sortedPosts = publishedPosts.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('sk-SK', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout 
  title="Blog | Chiropraxia Košice"
  description="Odborné články o zdraví chrbtice, prevencii bolesti a chiropraktickej starostlivosti. Praktické rady od skúsených chiropraktikov."
>
  <section class="py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Page Header -->
      <div class="text-center mb-16">
        <h1 class="text-3xl md:text-5xl font-bold mb-4">
          <span class="text-chrome">Odborný</span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-aurora to-aurora-glow"> blog</span>
        </h1>
        <p class="text-chrome-gray text-lg max-w-2xl mx-auto">
          Praktické rady, najnovšie poznatky a odborné články o zdraví vašej chrbtice.
        </p>
      </div>

      <FyzioFitBanner />

      <!-- Blog Grid -->
      {sortedPosts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="glass-card-interactive group block overflow-hidden">
              {post.data.coverImage && (
                <div class="aspect-video overflow-hidden">
                  <img 
                    src={post.data.coverImage} 
                    alt={post.data.coverImageAlt || post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-chrome-gray mb-3">
                  <span>{formatDate(post.data.publishDate)}</span>
                  <span>•</span>
                  <span>{post.data.author}</span>
                </div>
                <h2 class="text-xl font-semibold text-chrome mb-3 group-hover:text-aurora transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-chrome-gray text-sm line-clamp-3">
                  {post.data.seoDescription}
                </p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <div class="glass-card p-12 max-w-md mx-auto">
            <div class="text-4xl mb-4">📝</div>
            <h2 class="text-xl font-semibold text-chrome mb-2">Články pripravujeme</h2>
            <p class="text-chrome-gray text-sm">
              Čoskoro tu nájdete odborné články o zdraví chrbtice a chiropraktickej starostlivosti.
            </p>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>


