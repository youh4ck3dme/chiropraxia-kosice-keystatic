type BlogEntry = Awaited<ReturnType<typeof reader.collections.blog.read>>;
type BlogPost = { slug: string; entry: BlogEntry };

const allPosts: BlogPost[] = await Promise.all(
  allSlugs.map(async (slug: string): Promise<BlogPost> => ({
    slug,
    entry: await reader.collections.blog.read(slug),
  }))
);
const sortedPosts = allPosts
  .filter((p): p is { slug: string; entry: NonNullable<BlogEntry> } =>
    p.entry !== null && p.entry !== undefined && p.entry.status !== 'draft'
  )
  .sort((a, b) => {
    const dateA = a.entry.publishDate ? new Date(a.entry.publishDate).getTime() : -Infinity;
    const dateB = b.entry.publishDate ? new Date(b.entry.publishDate).getTime() : -Infinity;
    return dateB - dateA;
  });

const formatDate = (date: string | null) => {
  if (!date) return '';
  return new Date(date).toLocaleDateString('sk-SK', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
