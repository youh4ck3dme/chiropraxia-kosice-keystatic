---
import Layout from '../layouts/Layout.astro';
import { ServiceCard } from '../components/react/ServiceCard';

const services = [
  {
    id: '1',
    name: 'Chiropraktická masáž',
    description:
      'Kombinácia chiropraxie, klasickej masáže, mobilizácie, bankovania a masážnej pištole pre komplexnú úľavu.',
    duration_min: 50,
    price: 49,
  },
  {
    id: '2',
    name: 'Korekcia',
    description:
      'Rýchle chiropraktické ošetrenie zamerané na nápravu, doplnené o masážnu pištoľ a klasickú masáž.',
    duration_min: 15,
    price: 25,
  },
  {
    id: '3',
    name: 'Celotelová chiro masáž',
    description:
      'Dôkladná celotelová procedúra zahŕňajúca klasickú masáž, bankovanie, mobilizáciu a chiropraxiu.',
    duration_min: 70,
    price: 65,
  },
  {
    id: '4',
    name: 'Expresný termín',
    description: 'Príplatok k cene služby za termín do 2 pracovných dní alebo víkendové termíny.',
    duration_min: 0,
    price: 10,
  },
];

const faqs = [
  {
    question: 'Čo mám očakávať pri prvej návšteve?',
    answer:
      'Pri prvej návšteve vykonáme komplexné vyšetrenie vrátane anamnézy, fyzikálneho vyšetrenia a prípadne RTG snímkov. Na základe diagnostiky navrhneme individuálny liečebný plán.',
  },
  {
    question: 'Je chiropraktické ošetrenie bolestivé?',
    answer:
      "Väčšina pacientov opisuje ošetrenie ako príjemné uvoľnenie. Môžete cítiť mierny tlak alebo počuť 'prasknutie' pri úprave kĺbov, čo je úplne normálne a bezbolestné.",
  },
  {
    question: 'Koľko ošetrení potrebujem?',
    answer:
      'Závisí to od vášho stavu. Akútne problémy môžu vyžadovať 3-6 ošetrení, chronické stavy viac. Pri prvej konzultácii vám navrhneme realistický plán.',
  },
];

const rating = { value: 4.9, count: 520 };
---

<Layout
  title="Naše služby | Chiropraxia Košice"
  description="Chiropraktické služby v Košiciach: vyšetrenie chrbtice, manuálna terapia, liečba migrény, rehabilitácia. Pozrite si cenník a objednajte sa."
  faqs={faqs}
  rating={rating}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Service',
        serviceType: 'Chiropraxia a manuálna terapia',
        name: 'Komplexná náprava chrbtice',
        description:
          'Profesionálna chiropraktická starostlivosť zameraná na odstránenie bolesti krížov, krčnej chrbtice a kĺbov pomocou manuálnych techník.',
        provider: {
          '@type': 'MedicalClinic',
          name: 'Chiropraxia Košice',
        },
        areaServed: {
          '@type': 'City',
          name: 'Košice',
        },
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Služby ambulancie',
          itemListElement: [
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Vstupné vyšetrenie + Terapia',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Opakovaná náprava',
              },
            },
          ],
        },
      })}
    />
  </Fragment>
  <section class="px-6 py-12">
    <div class="mx-auto max-w-6xl">
      <!-- Page Header -->
      <div class="parallax-3d mb-16 text-center">
        <h1 class="mb-4 text-3xl font-bold md:text-5xl">
          <span class="text-chrome">Naše</span>
          <span class="from-aurora to-aurora-glow bg-gradient-to-r bg-clip-text text-transparent">
            služby</span
          >
        </h1>
        <p class="text-chrome-gray mx-auto max-w-2xl text-lg">
          Ponúkame široké spektrum chiropraktických služieb zameraných na riešenie bolestí
          pohybového aparátu.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="mb-16 grid gap-6 md:grid-cols-2">
        {
          services.map((service) => (
            <ServiceCard
              client:visible
              id={service.id}
              name={service.name}
              description={service.description}
              duration={service.duration_min}
              price={service.price}
            />
          ))
        }
      </div>

      <!-- CTA Section -->
      <div class="glass-card p-8 text-center md:p-12">
        <h2 class="text-chrome mb-4 text-2xl font-bold md:text-3xl">Pripravení začať?</h2>
        <p class="text-chrome-gray mx-auto mb-8 max-w-xl">
          Objednajte sa online a urobte prvý krok k životu bez bolesti.
        </p>
        <a href="/rezervacia" class="btn-aurora inline-flex px-8 py-4 text-lg">
          <span>Rezervovať termín</span>
        </a>
      </div>

      <!-- FAQ Section -->
      <div class="mt-20">
        <h2 class="text-chrome mb-12 text-center text-2xl font-bold">Často kladené otázky</h2>

        <div class="mx-auto max-w-3xl space-y-4">
          <details class="glass-card group p-6">
            <summary
              class="text-chrome flex cursor-pointer items-center justify-between font-medium"
            >
              Čo mám očakávať pri prvej návšteve?
              <svg
                class="text-aurora h-5 w-5 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </summary>
            <p class="text-chrome-gray mt-4 text-sm">
              Pri prvej návšteve vykonáme komplexné vyšetrenie vrátane anamnézy, fyzikálneho
              vyšetrenia a prípadne RTG snímkov. Na základe diagnostiky navrhneme individuálny
              liečebný plán.
            </p>
          </details>

          <details class="glass-card group p-6">
            <summary
              class="text-chrome flex cursor-pointer items-center justify-between font-medium"
            >
              Je chiropraktické ošetrenie bolestivé?
              <svg
                class="text-aurora h-5 w-5 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </summary>
            <p class="text-chrome-gray mt-4 text-sm">
              Väčšina pacientov opisuje ošetrenie ako príjemné uvoľnenie. Môžete cítiť mierny tlak
              alebo počuť "prasknutie" pri úprave kĺbov, čo je úplne normálne a bezbolestné.
            </p>
          </details>

          <details class="glass-card group p-6">
            <summary
              class="text-chrome flex cursor-pointer items-center justify-between font-medium"
            >
              Koľko ošetrení potrebujem?
              <svg
                class="text-aurora h-5 w-5 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </summary>
            <p class="text-chrome-gray mt-4 text-sm">
              Závisí to od vášho stavu. Akútne problémy môžu vyžadovať 3-6 ošetrení, chronické stavy
              viac. Pri prvej konzultácii vám navrhneme realistický plán.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>
</Layout>
