---
import Layout from '../../layouts/Layout.astro';
import { Logo } from '../../components/react/Logo';

const already = Astro.url.searchParams.get('already') === 'true';
---

<Layout title="Rezervácia zrušená | Chiropraxia Košice">
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    <div class="w-full max-w-md text-center">
      <div class="mb-8">
        <Logo className="text-void mx-auto h-auto w-48 opacity-50" />
      </div>

      <div class="glass-card border-red-500/20 p-8">
        <div
          class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-red-500/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-10 w-10 text-red-500"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>

        <h1 class="mb-4 text-3xl font-bold text-white">
          {already ? 'Rezervácia už bola zrušená' : 'Vaša rezervácia bola zrušená'}
        </h1>

        <p class="text-chrome-gray mb-8">
          Termín bol úspešne uvoľnený. Ak ste si to rozmysleli, môžete si kedykoľvek vytvoriť novú
          rezerváciu.
        </p>

        <div class="flex flex-col gap-4">
          <a href="https://booking.fyzioafit.sk" class="btn-aurora w-full justify-center py-3">
            Vytvoriť novú rezerváciu
          </a>
          <a href="/" class="btn-glass w-full justify-center py-3"> Späť na úvod </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .btn-aurora {
    background: var(--color-aurora);
    color: black;
    font-weight: bold;
    border-radius: 0.75rem;
    display: flex;
    transition: all 0.2s;
  }
  .btn-aurora:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -5px var(--color-aurora-glow);
  }
  .btn-glass {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 0.75rem;
    display: flex;
    transition: all 0.2s;
  }
</style>
