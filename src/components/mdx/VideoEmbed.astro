---
interface Props {
  url: string;
  title?: string;
}

const { url, title = 'Video' } = Astro.props;

// Extract video ID and platform
function getVideoData(url: string) {
  // YouTube
  const ytMatch = url.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/
  );
  if (ytMatch) {
    return {
      platform: 'youtube',
      id: ytMatch[1],
      embedUrl: `https://www.youtube-nocookie.com/embed/${ytMatch[1]}?rel=0`,
      thumbnail: `https://img.youtube.com/vi/${ytMatch[1]}/maxresdefault.jpg`,
    };
  }

  // Vimeo
  const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);
  if (vimeoMatch) {
    return {
      platform: 'vimeo',
      id: vimeoMatch[1],
      embedUrl: `https://player.vimeo.com/video/${vimeoMatch[1]}?dnt=1`,
      thumbnail: null, // Vimeo thumbnails require API call
    };
  }

  return null;
}

const video = getVideoData(url);
---

{
  video && (
    <div class="video-embed bg-chrome-dark my-8 overflow-hidden rounded-xl border border-white/10">
      <div class="group relative aspect-video">
        {/* Lazy Load: Show thumbnail first, load iframe on click */}
        <div
          class="video-placeholder absolute inset-0 cursor-pointer"
          data-embed-url={video.embedUrl}
        >
          {video.thumbnail && (
            <img
              src={video.thumbnail}
              alt={title}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          )}

          {/* Play Button Overlay */}
          <div class="absolute inset-0 flex items-center justify-center bg-black/40 transition-colors group-hover:bg-black/30">
            <div class="bg-aurora shadow-aurora/30 flex h-16 w-16 items-center justify-center rounded-full text-black shadow-lg transition-transform group-hover:scale-110">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>
        </div>

        {/* Iframe container (hidden until clicked) */}
        <div class="video-iframe absolute inset-0 hidden" />
      </div>

      {title && <div class="border-t border-white/5 p-3 text-sm text-gray-400">📹 {title}</div>}
    </div>
  )
}

<script>
  document.querySelectorAll('.video-placeholder').forEach((placeholder) => {
    placeholder.addEventListener('click', () => {
      const embedUrl = placeholder.getAttribute('data-embed-url');
      const iframeContainer = placeholder.nextElementSibling;

      if (embedUrl && iframeContainer) {
        iframeContainer.innerHTML = `
          <iframe 
            src="${embedUrl}&autoplay=1" 
            class="w-full h-full"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            title="Prehrávač videa"
          ></iframe>
        `;
        iframeContainer.classList.remove('hidden');
        placeholder.classList.add('hidden');
      }
    });
  });
</script>
