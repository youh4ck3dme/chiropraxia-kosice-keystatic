---

---

<div class="glass-card group relative overflow-hidden rounded-2xl p-8">
  <h2 class="text-chrome relative z-10 mb-6 text-2xl font-bold">Napíšte nám</h2>

  <form id="contact-form" class="relative z-10 space-y-4">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <label for="name" class="text-chrome-gray mb-1 block text-sm font-medium">Meno</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="input-glass w-full"
          placeholder="Ján Novák"
        />
      </div>
      <div>
        <label for="phone" class="text-chrome-gray mb-1 block text-sm font-medium">Tel. číslo</label
        >
        <input
          type="tel"
          id="phone"
          name="phone"
          class="input-glass w-full"
          placeholder="+421 9XX XXX XXX"
        />
      </div>
    </div>

    <div>
      <label for="email" class="text-chrome-gray mb-1 block text-sm font-medium">Email *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="input-glass w-full"
        placeholder="vas@email.com"
      />
    </div>

    <div>
      <label for="message" class="text-chrome-gray mb-1 block text-sm font-medium">Správa *</label>
      <textarea
        id="message"
        name="message"
        required
        rows="4"
        class="input-glass w-full resize-none"
        placeholder="Ako vám môžeme pomôcť?"></textarea>
    </div>

    <div class="text-chrome-gray mb-4 flex items-center gap-2 text-sm">
      <input
        type="checkbox"
        required
        id="contact-gdpr"
        class="border-glass-subtle bg-glass-dark text-aurora focus:ring-aurora/50 rounded"
      />
      <label for="contact-gdpr">Súhlasím so spracovaním osobných údajov</label>
    </div>

    <button
      type="submit"
      class="btn-aurora w-full justify-center transition-transform group-hover:scale-[1.02]"
    >
      <span id="btn-text">Odoslať správu</span>
      <div
        id="btn-loader"
        class="hidden h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"
      >
      </div>
    </button>

    <div id="form-status" class="mt-4 hidden rounded-lg p-3 text-center text-sm"></div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');
  const btnText = document.getElementById('btn-text');
  const btnLoader = document.getElementById('btn-loader');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !btnText || !btnLoader) return;

    // Reset UI
    statusEl.classList.add('hidden');
    statusEl.className = 'hidden mt-4 p-3 rounded-lg text-center text-sm';
    btnText.classList.add('hidden');
    btnLoader.classList.remove('hidden');

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const json = await res.json();

      if (res.ok) {
        statusEl.textContent = 'Správa bola úspešne odoslaná! Ozveme sa vám čoskoro.';
        statusEl.classList.remove('hidden');
        statusEl.classList.add(
          'bg-green-500/10',
          'text-green-400',
          'border',
          'border-green-500/20'
        );
        form.reset();
      } else {
        throw new Error(json.error || 'Chyba odosielania');
      }
    } catch (_err) {
      statusEl.classList.remove('hidden');
      statusEl.classList.add('bg-red-500/10', 'text-red-400', 'border', 'border-red-500/20');
    } finally {
      btnText.classList.remove('hidden');
      btnLoader.classList.add('hidden');
    }
  });
</script>
