---
---

<div class="glass-card p-8 rounded-2xl relative overflow-hidden group">
  <h2 class="text-2xl font-bold text-chrome mb-6 relative z-10">Napíšte nám</h2>
  
  <form id="contact-form" class="space-y-4 relative z-10">
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label for="name" class="block text-sm font-medium text-chrome-gray mb-1">Meno</label>
        <input 
          type="text" 
          id="name" 
          name="name"
          required
          class="input-glass w-full"
          placeholder="Ján Novák"
        />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-chrome-gray mb-1">Tel. číslo</label>
        <input 
          type="tel" 
          id="phone" 
          name="phone"
          class="input-glass w-full"
          placeholder="+421 9XX XXX XXX"
        />
      </div>
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-chrome-gray mb-1">Email *</label>
      <input 
        type="email" 
        id="email" 
        name="email"
        required
        class="input-glass w-full"
        placeholder="vas@email.com"
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-chrome-gray mb-1">Správa *</label>
      <textarea 
        id="message" 
        name="message"
        required
        rows="4"
        class="input-glass w-full resize-none"
        placeholder="Ako vám môžeme pomôcť?"
      ></textarea>
    </div>

    <div class="flex items-center gap-2 text-sm text-chrome-gray mb-4">
      <input type="checkbox" required id="contact-gdpr" class="rounded border-glass-subtle bg-glass-dark text-aurora focus:ring-aurora/50" />
      <label for="contact-gdpr">Súhlasím so spracovaním osobných údajov</label>
    </div>

    <button type="submit" class="btn-aurora w-full justify-center group-hover:scale-[1.02] transition-transform">
      <span id="btn-text">Odoslať správu</span>
      <div id="btn-loader" class="hidden w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
    </button>
    
    <div id="form-status" class="hidden mt-4 p-3 rounded-lg text-center text-sm"></div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');
  const btnText = document.getElementById('btn-text');
  const btnLoader = document.getElementById('btn-loader');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl || !btnText || !btnLoader) return;

    // Reset UI
    statusEl.classList.add('hidden');
    statusEl.className = 'hidden mt-4 p-3 rounded-lg text-center text-sm';
    btnText.classList.add('hidden');
    btnLoader.classList.remove('hidden');

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const json = await res.json();

      if (res.ok) {
        statusEl.textContent = 'Správa bola úspešne odoslaná! Ozveme sa vám čoskoro.';
        statusEl.classList.remove('hidden');
        statusEl.classList.add('bg-green-500/10', 'text-green-400', 'border', 'border-green-500/20');
        form.reset();
      } else {
        throw new Error(json.error || 'Chyba odosielania');
      }
    } catch (err) {
      statusEl.textContent = 'Nepodarilo sa odoslať správu. Skúste to prosím neskôr.';
      statusEl.classList.remove('hidden');
      statusEl.classList.add('bg-red-500/10', 'text-red-400', 'border', 'border-red-500/20');
    } finally {
      btnText.classList.remove('hidden');
      btnLoader.classList.add('hidden');
    }
  });
</script>


