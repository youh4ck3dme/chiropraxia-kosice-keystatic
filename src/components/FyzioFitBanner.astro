---
---
<a href="https://www.fyzioafit.sk/" target="_blank" rel="noopener noreferrer" class="group block relative overflow-hidden rounded-2xl my-8 transform transition-all duration-500 hover:scale-[1.01] shadow-xl hover:shadow-aurora/20">
  
  <!-- Premium Background Image -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/fyzio-fit-bg.png" 
      alt="FYZIO&FIT Background" 
      class="w-full h-full object-cover transition-transform duration-[3s] group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px] transition-all"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent"></div>
  </div>
  
  <!-- Content Container (More Compact) -->
  <div class="relative z-10 p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 border border-white/5 backdrop-blur-sm bg-white/5">
    
    <!-- Left Content -->
    <div class="flex-1 text-center md:text-left space-y-3">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
        <span class="px-3 py-1 rounded-full bg-aurora text-black text-[9px] font-black uppercase tracking-widest shadow-lg shadow-aurora/20">
          Odporúčame
        </span>
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-black/30 border border-white/5">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span class="text-[9px] font-bold text-white/80 uppercase tracking-widest">Otvorené</span>
        </div>
      </div>
      
      <div class="space-y-1">
        <h3 class="text-2xl md:text-4xl font-black text-white tracking-tight leading-none">
          FYZIO <span class="text-aurora">&</span> FIT
        </h3>
        <p class="text-sm md:text-lg text-white/90 font-medium">
           Doprajte si <span class="text-aurora font-black">najlepšiu starostlivosť</span> v Košiciach.
        </p>
      </div>

      <p class="text-xs md:text-sm text-white drop-shadow-md max-w-lg text-shadow-sm">
        Špičková fyzioterapia, masáže a chiropraxia pod jednou strechou. 
        Nájdite svoju rovnováhu.
      </p>

      <!-- Smaller Trust Badges -->
      <div class="flex justify-center md:justify-start gap-6 pt-2 border-t border-white/5">
        <div class="flex flex-col">
            <span class="text-white font-black text-sm leading-tight">100%</span>
            <span class="text-[8px] text-chrome-gray uppercase tracking-widest">Kvalita</span>
        </div>
        <div class="flex flex-col">
            <span class="text-white font-black text-sm leading-tight">Elite</span>
            <span class="text-[8px] text-chrome-gray uppercase tracking-widest">Tím</span>
        </div>
        <div class="flex flex-col">
            <span class="text-white font-black text-sm leading-tight">Modern</span>
            <span class="text-[8px] text-chrome-gray uppercase tracking-widest">Ambulancia</span>
        </div>
      </div>
    </div>

    <!-- Right: CTA Button (Smaller) -->
    <div class="shrink-0">
      <div class="relative bg-white text-black font-black text-sm px-6 py-3 rounded-xl flex items-center gap-3 transform transition-all duration-300 hover:bg-aurora active:scale-95 shadow-lg">
        <span class="tracking-widest">REZERVOVAŤ</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>
  </div>
</a>

