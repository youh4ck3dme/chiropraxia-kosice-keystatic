---

---

<a
  href="https://www.fyzioafit.sk/"
  target="_blank"
  rel="noopener noreferrer"
  class="group hover:shadow-aurora/20 relative my-8 block transform overflow-hidden rounded-2xl shadow-xl transition-all duration-500 hover:scale-[1.01]"
>
  <!-- Premium Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/fyzio-fit-bg.png"
      alt="FYZIO&FIT Background"
      class="h-full w-full object-cover transition-transform duration-[3s] group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px] transition-all"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent"></div>
  </div>

  <!-- Content Container (More Compact) -->
  <div
    class="relative z-10 flex flex-col items-center justify-between gap-6 border border-white/5 bg-white/5 p-6 backdrop-blur-sm md:flex-row md:p-8"
  >
    <!-- Left Content -->
    <div class="flex-1 space-y-3 text-center md:text-left">
      <div class="flex flex-wrap items-center justify-center gap-2 md:justify-start">
        <span
          class="bg-aurora shadow-aurora/20 rounded-full px-3 py-1 text-[9px] font-black tracking-widest text-black uppercase shadow-lg"
        >
          Odporúčame
        </span>
        <div
          class="flex items-center gap-2 rounded-full border border-white/5 bg-black/30 px-3 py-1"
        >
          <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"></span>
          <span class="text-[9px] font-bold tracking-widest text-white/80 uppercase">Otvorené</span>
        </div>
      </div>

      <div class="space-y-1">
        <h3 class="text-2xl leading-none font-black tracking-tight text-white md:text-4xl">
          FYZIO <span class="text-aurora">&</span> FIT
        </h3>
        <p class="text-sm font-medium text-white/90 md:text-lg">
          Doprajte si <span class="text-aurora font-black">najlepšiu starostlivosť</span> v Košiciach.
        </p>
      </div>

      <p class="max-w-lg text-xs text-white drop-shadow-md text-shadow-sm md:text-sm">
        Špičková fyzioterapia, masáže a chiropraxia pod jednou strechou. Nájdite svoju rovnováhu.
      </p>

      <!-- Smaller Trust Badges -->
      <div class="flex justify-center gap-6 border-t border-white/5 pt-2 md:justify-start">
        <div class="flex flex-col">
          <span class="text-sm leading-tight font-black text-white">100%</span>
          <span class="text-chrome-gray text-[8px] tracking-widest uppercase">Kvalita</span>
        </div>
        <div class="flex flex-col">
          <span class="text-sm leading-tight font-black text-white">Elite</span>
          <span class="text-chrome-gray text-[8px] tracking-widest uppercase">Tím</span>
        </div>
        <div class="flex flex-col">
          <span class="text-sm leading-tight font-black text-white">Modern</span>
          <span class="text-chrome-gray text-[8px] tracking-widest uppercase">Ambulancia</span>
        </div>
      </div>
    </div>

    <!-- Right: CTA Button (Smaller) -->
    <div class="shrink-0">
      <div
        class="hover:bg-aurora relative flex transform items-center gap-3 rounded-xl bg-white px-6 py-3 text-sm font-black text-black shadow-lg transition-all duration-300 active:scale-95"
      >
        <span class="tracking-widest">REZERVOVAŤ</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>
  </div>
</a>

<style></style>
