---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
  currentCategory: string;
}

const { currentSlug, currentCategory } = Astro.props;

// Fetch all posts except current one
const allPosts = await getCollection('blog', ({ slug }) => slug !== currentSlug);

// 1. Prioritize posts from same category
const relatedByCategory = allPosts.filter(post => post.data.category === currentCategory);

// 2. Fallback to other posts if not enough
const otherPosts = allPosts.filter(post => post.data.category !== currentCategory);

// Combine and limit to 3
const relatedPosts = [...relatedByCategory, ...otherPosts].slice(0, 3);

const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('sk-SK', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};
---

{relatedPosts.length > 0 && (
  <section class="mt-24 border-t border-white/10 pt-16">
    <h2 class="text-3xl font-bold text-white mb-12 flex items-center gap-3">
      <span class="text-aurora">✦</span>
      Podobné články
    </h2>

    <div class="grid md:grid-cols-3 gap-8">
      {relatedPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group group-hover:no-underline">
          <article class="h-full glass-card overflow-hidden hover:scale-[1.02] transition-transform duration-500 flex flex-col">
            {/* Image */}
            <div class="aspect-[16/9] overflow-hidden relative">
              <div class="absolute inset-0 bg-aurora-purple/20 group-hover:opacity-0 transition-opacity z-10"></div>
              {post.data.coverImage ? (
                <img 
                  src={post.data.coverImage} 
                  alt={post.data.coverImageAlt || post.data.title}
                  class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
                  <span class="text-4xl">📄</span>
                </div>
              )}
            </div>

            {/* Content */}
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-4 text-xs text-chrome-gray mb-3">
                <span class="uppercase tracking-wider font-medium text-aurora">
                  {post.data.category}
                </span>
                <span>•</span>
                <span>{formatDate(post.data.publishDate)}</span>
              </div>
              
              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-aurora transition-colors leading-tight">
                {post.data.title}
              </h3>
              
              <p class="text-gray-400 text-sm line-clamp-3 mb-4 flex-1">
                {post.data.seoDescription}
              </p>

              <div class="flex items-center text-sm font-medium text-aurora mt-auto">
                Čítať viac
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>
)}


