---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
  currentCategory: string;
}

const { currentSlug, currentCategory } = Astro.props;

// Fetch all posts except current one
const allPosts = await getCollection('blog', ({ slug }) => slug !== currentSlug);

// 1. Prioritize posts from same category
const relatedByCategory = allPosts.filter((post) => post.data.category === currentCategory);

// 2. Fallback to other posts if not enough
const otherPosts = allPosts.filter((post) => post.data.category !== currentCategory);

// Combine and limit to 3
const relatedPosts = [...relatedByCategory, ...otherPosts].slice(0, 3);

const formatDate = (date: Date) => {
  return new Date(date).toLocaleDateString('sk-SK', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
};
---

{
  relatedPosts.length > 0 && (
    <section class="mt-24 border-t border-white/10 pt-16">
      <h2 class="mb-12 flex items-center gap-3 text-3xl font-bold text-white">
        <span class="text-aurora">✦</span>
        Podobné články
      </h2>

      <div class="grid gap-8 md:grid-cols-3">
        {relatedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group group-hover:no-underline">
            <article class="glass-card flex h-full flex-col overflow-hidden transition-transform duration-500 hover:scale-[1.02]">
              {/* Image */}
              <div class="relative aspect-[16/9] overflow-hidden">
                <div class="bg-aurora-purple/20 absolute inset-0 z-10 transition-opacity group-hover:opacity-0" />
                {post.data.coverImage ? (
                  <img
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt || post.data.title}
                    class="h-full w-full transform object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-gray-800 to-gray-900">
                    <span class="text-4xl">📄</span>
                  </div>
                )}
              </div>

              {/* Content */}
              <div class="flex flex-1 flex-col p-6">
                <div class="text-chrome-gray mb-3 flex items-center gap-4 text-xs">
                  <span class="text-aurora font-medium tracking-wider uppercase">
                    {post.data.category}
                  </span>
                  <span>•</span>
                  <span>{formatDate(post.data.publishDate)}</span>
                </div>

                <h3 class="group-hover:text-aurora mb-3 text-xl leading-tight font-bold text-white transition-colors">
                  {post.data.title}
                </h3>

                <p class="mb-4 line-clamp-3 flex-1 text-sm text-gray-400">
                  {post.data.seoDescription}
                </p>

                <div class="text-aurora mt-auto flex items-center text-sm font-medium">
                  Čítať viac
                  <svg
                    class="ml-1 h-4 w-4 transform transition-transform group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>
  )
}
