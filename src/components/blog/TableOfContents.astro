---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter only h2 and h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <nav class="toc-container sticky top-32 glass-card p-6 border border-white/5 backdrop-blur-xl animate-fade-in transition-all duration-300">
    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-white/5">
      <!-- Pixel-Perfect Custom SVG Icon for "Content" -->
      <div class="w-8 h-8 rounded-lg bg-aurora/10 flex items-center justify-center text-aurora shadow-inner shadow-aurora/5">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18"></path>
          <path d="M3 12h18"></path>
          <path d="M3 18h18"></path>
          <circle cx="3" cy="6" r="1" fill="currentColor" stroke="none"></circle>
          <circle cx="3" cy="12" r="1" fill="currentColor" stroke="none"></circle>
          <circle cx="3" cy="18" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </div>
      <span class="font-bold text-chrome tracking-wide text-sm uppercase">Obsah článku</span>
    </div>

    <ul class="space-y-1 relative">
      <!-- Active Indicator (Animated) -->
      <div id="active-indicator" class="absolute left-0 w-0.5 h-6 bg-aurora rounded-full transition-all duration-300 ease-out opacity-0"></div>

      {toc.map((heading) => (
        <li class={`toc-item ${heading.depth === 3 ? 'pl-4' : ''}`}>
          <a 
            href={`#${heading.slug}`} 
            class="group flex items-start py-2 pr-2 text-sm text-gray-400 hover:text-white transition-colors duration-200 border-l-2 border-transparent hover:border-white/10 pl-3 -ml-0.5"
            data-slug={heading.slug}
          >
            <span class="mr-2 mt-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-aurora transform group-hover:translate-x-1">
               <svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="stroke-current" stroke-width="2">
                 <path d="M4 2L8 6L4 10"></path>
               </svg>
            </span>
            <span class="leading-relaxed">{heading.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Intersection Observer for highlighting active TOC item
  const observerOptions = {
    root: null,
    rootMargin: '-100px 0px -66% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const id = entry.target.getAttribute('id');
      const tocLink = document.querySelector(`.toc-item a[href="#${id}"]`);
      
      if (entry.isIntersecting && tocLink) {
        // Remove active class from all
        document.querySelectorAll('.toc-item a').forEach((link) => {
          link.classList.remove('text-aurora', 'font-medium');
          link.classList.add('text-gray-400');
        });

        // Add active class to current
        tocLink.classList.remove('text-gray-400');
        tocLink.classList.add('text-aurora', 'font-medium');
        
        // Move indicator (Optional fancy effect)
        const indicator = document.getElementById('active-indicator');
        if (indicator && tocLink instanceof HTMLElement) {
          indicator.style.top = `${tocLink.offsetTop + 8}px`; // Adjust based on padding
          indicator.style.opacity = '1';
        }
      }
    });
  }, observerOptions);

  // Track all headings
  document.querySelectorAll('h2, h3').forEach((heading) => {
    observer.observe(heading);
  });
</script>

<style>
  /* Custom Scrollbar for TOC if it gets too long */
  .toc-container {
    max-height: calc(100vh - 150px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }
</style>


