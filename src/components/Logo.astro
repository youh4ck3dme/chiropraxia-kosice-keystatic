---
interface Props {
  className?: string;
}

const { className = "h-12 w-auto" } = Astro.props;
---

<div class={`${className} flex items-center justify-center overflow-hidden rounded-xl`}>
  <img 
    src="/chiropraxia.webp" 
    alt="Chiropraxia Košice Logo" 
    class="h-full w-full object-contain mix-blend-screen brightness-110 contrast-125 opacity-85"
    loading="eager"
  />
</div>

